# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------
# Public origin used for canonical URLs, Stripe redirects, and emails.
NEXT_PUBLIC_APP_URL=https://leadshield.live
NEXT_PUBLIC_SUPPORT_EMAIL=support@coaibakersfield.com
# Length of the self-serve trial in days (default 14).
NEXT_PUBLIC_TRIAL_DAYS=14

# ---------------------------------------------------------------
# Database and authentication (required)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Missed-call text back (Telnyx)
# ---------------------------------------------------------------
TELNYX_API_KEY=
TELNYX_DEMO_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
LEADSHIELD_SYNC_TOKEN=

# ---------------------------------------------------------------
# Connected service deployments (optional modules)
# ---------------------------------------------------------------
NEXT_PUBLIC_LEAD_ENGINE_URL=
NEXT_PUBLIC_GRANT_COMMAND_URL=
NEXT_PUBLIC_SMALLCLAIMS_URL=

# Server-side health endpoints used by the admin orchestrator
LEAD_ENGINE_HEALTH_URL=
CONSTRUCTION_COLLECTIONS_HEALTH_URL=
GRANT_COMMAND_HEALTH_URL=

# ---------------------------------------------------------------
# Email (Resend) — new-trial alerts and customer receipts
# ---------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where new self-serve trial notifications are sent.
SIGNUP_NOTIFY_EMAIL=

# ---------------------------------------------------------------
# Billing (Stripe) — create one recurring price per plan per interval
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_OPERATOR=
STRIPE_PRICE_OPERATOR_ANNUAL=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TEAM_ANNUAL=
# Legacy price key kept for existing deployments.
STRIPE_PRICE_VOICE=

# ---------------------------------------------------------------
# Operations
# ---------------------------------------------------------------
# Shared secret Vercel Cron sends as "Authorization: Bearer <value>".
CRON_SECRET=
